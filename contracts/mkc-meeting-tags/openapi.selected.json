{
  "openapi": "3.1.0",
  "paths": {
    "/v1/meeting-tags": {
      "get": {
        "summary": "List owner-private canonical meeting tag definitions and retained aliases",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Current tag definitions in canonical namespace order",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MeetingTagDefinitionListV1"
                }
              }
            }
          },
          "403": {
            "description": "User-bound session required",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/v1/meeting-tags/mutations": {
      "post": {
        "summary": "Create, rename, assign, or tombstone a meeting tag atomically and idempotently",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Immutable meeting tag mutation receipt",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MeetingTagMutationReceiptV1"
                }
              }
            }
          },
          "403": {
            "description": "User-bound session required",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "404": {
            "description": "Owner-safe meeting or tag not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "409": {
            "description": "Namespace, revision, or idempotency conflict",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "422": {
            "description": "Invalid tag mutation",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "503": {
            "description": "Transient mutation failure; retry with the same idempotency key",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/MeetingTagMutationRequestV1"
              }
            }
          }
        }
      }
    },
    "/v1/meetings/{sourceKey}/tags": {
      "get": {
        "summary": "Read authoritative current and tombstoned tag state for one owned meeting",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Owner-bound canonical meeting tag state",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MeetingTagStateV1"
                }
              }
            }
          },
          "403": {
            "description": "User-bound session required",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "404": {
            "description": "Owner-safe meeting not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "schemas": {
    "MeetingTagDefinitionV1": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "display_label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240
        },
        "normalized_value": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240
        },
        "schema_version": {
          "type": "string",
          "const": "mkc.meeting-tag-definition.v1"
        },
        "tag_id": {
          "type": "string",
          "pattern": "^tag_[a-z0-9]{20,64}$"
        },
        "visibility": {
          "type": "string",
          "const": "owner_private"
        },
        "revision": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "aliases": {
          "maxItems": 100,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "display_label": {
                "type": "string",
                "minLength": 1,
                "maxLength": 240
              },
              "normalized_value": {
                "type": "string",
                "minLength": 1,
                "maxLength": 240
              },
              "added_in_revision": {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991
              },
              "added_at": {
                "type": "string",
                "format": "date-time",
                "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$"
              }
            },
            "required": [
              "display_label",
              "normalized_value",
              "added_in_revision",
              "added_at"
            ],
            "additionalProperties": false
          }
        },
        "created_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$"
        },
        "updated_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$"
        }
      },
      "required": [
        "display_label",
        "normalized_value",
        "schema_version",
        "tag_id",
        "visibility",
        "revision",
        "aliases",
        "created_at",
        "updated_at"
      ],
      "additionalProperties": false
    },
